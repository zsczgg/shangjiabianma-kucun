generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Warehouse {
  id String @id @default(cuid())
  code String @unique
  name String
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  balances InventoryBalance[]
  movements StockMovement[]
  counts StockCount[]
}

model CatalogSku {
  id String @id @default(cuid())
  internalCode String @unique
  upstreamSkuId String?
  productName String
  brand String?
  category String?
  spec String
  imageUrl String?
  productStatus String @default("ACTIVE")
  skuStatus String @default("ACTIVE")
  manufacturerBarcode String?
  warehouseCode String?
  otherCodesJson String @default("[]")
  platformMappingsJson String @default("[]")
  upstreamUpdatedAt DateTime?
  lastSyncedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  balances InventoryBalance[]
  movements StockMovement[]
  countItems StockCountItem[]
  @@index([productName])
  @@index([manufacturerBarcode])
  @@index([warehouseCode])
}

model InventoryBalance {
  id String @id @default(cuid())
  warehouseId String
  skuId String
  quantity Int @default(0)
  lowStockThreshold Int @default(5)
  usesDefaultThreshold Boolean @default(true)
  updatedAt DateTime @updatedAt
  warehouse Warehouse @relation(fields:[warehouseId], references:[id], onDelete:Cascade)
  sku CatalogSku @relation(fields:[skuId], references:[id], onDelete:Restrict)
  @@unique([warehouseId, skuId])
}

model StockMovement {
  id String @id @default(cuid())
  movementNo String @unique
  warehouseId String
  skuId String
  type String
  quantity Int
  balanceBefore Int
  balanceAfter Int
  referenceNo String?
  note String?
  source String @default("MANUAL")
  createdAt DateTime @default(now())
  warehouse Warehouse @relation(fields:[warehouseId], references:[id], onDelete:Restrict)
  sku CatalogSku @relation(fields:[skuId], references:[id], onDelete:Restrict)
  @@index([createdAt])
  @@index([skuId, createdAt])
}

model StockCount {
  id String @id @default(cuid())
  countNo String @unique
  warehouseId String
  status String @default("DRAFT")
  note String?
  createdAt DateTime @default(now())
  completedAt DateTime?
  warehouse Warehouse @relation(fields:[warehouseId], references:[id], onDelete:Restrict)
  items StockCountItem[]
}

model StockCountItem {
  id String @id @default(cuid())
  countId String
  skuId String
  bookQuantity Int
  countedQuantity Int
  difference Int
  movementId String?
  count StockCount @relation(fields:[countId], references:[id], onDelete:Cascade)
  sku CatalogSku @relation(fields:[skuId], references:[id], onDelete:Restrict)
  @@unique([countId, skuId])
}

model SyncRun {
  id String @id @default(cuid())
  trigger String
  status String @default("RUNNING")
  fetched Int @default(0)
  created Int @default(0)
  updated Int @default(0)
  errorMessage String?
  startedAt DateTime @default(now())
  finishedAt DateTime?
}

model AppSetting {
  key String @id
  value String
  updatedAt DateTime @updatedAt
}
